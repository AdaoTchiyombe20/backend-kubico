// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model users {
  id             Int       @id @unique @default(autoincrement())
  email          String    @unique
  password       String
  status         UserStatus @default(ACTIVE)
  email_verified Boolean   @default(false)
  last_access    DateTime?
  date_register  DateTime  @default(now())

  refreshTokens  refresh_tokens[]
  emailVerified  emailVerification[]
  restrictionsHistory userRestrictionsHistory[]
  profile        profiles?
  admin          admins?

  @@index([email])
}

model userRestrictionsHistory {
  id Int @id @default(autoincrement())
  user_id Int
  is_active Boolean @default(true)
  new_ban_status UserBanStatus
  changed_at DateTime @default(now())
  ended_at DateTime?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, changed_at])
}

model roles {
  id          Int           @id @default(autoincrement())
  role        ProfileRoles     @unique
  description String
  
  user_role   profile_roles[]
}

model profiles {
  id              Int          @id @default(autoincrement())
  user_id         Int          @unique
  type            ProfileType
  deleted_at      DateTime?

  userMidia       profile_data[]
  user_role       profile_roles[]

  person_profile  person_profiles?
  company_profile company_profiles?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade )
}

model person_profiles {
  id         Int      @id @default(autoincrement())
  profile_id Int      @unique
  full_name  String
  birth_date DateTime

  profile profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)
}

model company_profiles {
  id               Int      @id @default(autoincrement())
  profile_id       Int      @unique
  legal_name       String

  profile profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)
}

model profile_data {
  id              Int       @id @default(autoincrement())
  profile_id      Int
  type            DocType
  document_number String
  is_current      Boolean   @default(true)
  is_verified     Boolean   @default(false)
  verified_at     DateTime?
  inserted_in     DateTime  @default(now())
  deleted_at      DateTime?

  profile profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([type, document_number])
  @@index([profile_id, type])
  @@index([profile_id, type, is_current])
}

model profile_roles {
  id          Int            @id @default(autoincrement())
  profile_id  Int
  role_id     Int
  status      UserRoleStatus @default(PENDING)
  is_active   Boolean        @default(false)
  approved_at DateTime?
  created_at  DateTime       @default(now())

  role     roles    @relation(fields: [role_id], references: [id])
  profile  profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  admin    admins?  @relation(name: "AdminProfile")

  @@unique([profile_id, role_id], name: "profile_id_role_id")
  properties properties[] 
  property_history propertyHistory[]
  negociationEvents negociationEvent[]
  favorites favorites[]

  client negociation[] @relation(name: "NegociationClient")
  owner negociation[] @relation(name: "NegociationOwner")
}

model admins {
  id               Int         @id @default(autoincrement())
  profile_role_id  Int         @unique
  user_id          Int         @unique
  adminsName       String
  access_level     AccessLevel @default(NORMAL)
  date_register    DateTime    @default(now())
  deleted_at       DateTime?

  profile_role   profile_roles   @relation(name: "AdminProfile", fields: [profile_role_id], references: [id], onDelete: Cascade)
  user           users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model refresh_tokens {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  user_id   Int
  expiresAt DateTime
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([token])
  @@index([expiresAt])
}

model emailVerification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  code       String
  expires_at DateTime
  used       Boolean  @default(false)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([user_id, used, expires_at])
}

model properties {
  id Int @id @default(autoincrement())
  id_owner Int
  title String
  type_property_purchase Property_purchase
  type_of_property TypeProperties
  description String
  status_property PropertyStatus
  is_negotiable Boolean @default(false)
  price Int
  total_area Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime? // ✅ NOVO: soft delete

  owner profile_roles @relation(fields: [id_owner],references: [id], onDelete: Cascade)

  property_localization propertyLocalization?
  property_restrictions_history propertyRestrictionsHistory[]
  property_compartments propertyCompartments[]
  property_medias propertyMedia[]
  property_listing propertyListing[]
  property_history propertyHistory[]
  favorites favorites[]

  // ✅ Índices
  @@unique([id_owner, id]) // Garantir que usuário só acessa suas propriedades
  @@index([status_property]) // Queries por status
  @@index([created_at]) // Ordenação por data
  @@index([deleted_at]) // Soft deletes
}

model propertyRestrictionsHistory {
  id Int @id @default(autoincrement())
  property_id Int
  new_ban_status ListingRestrictionStatus
  changed_at DateTime @default(now())
  ended_at DateTime?

  property properties @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@index([property_id, changed_at])
}

model propertyHistory {
  id Int @id @default(autoincrement())
  id_owner Int 
  id_property Int 
  last_status propertySelingStatus
  new_status propertySelingStatus
  started_at DateTime @default(now())
  ended_at DateTime?

  owner profile_roles @relation(fields: [id_owner], references: [id], onDelete: Cascade)
  property properties @relation(fields: [id_property], references: [id], onDelete: Cascade)

   // ✅ Índices para auditoria
  @@index([id_property, started_at]) // Timeline de uma propriedade
  @@index([id_owner, started_at]) // Timeline de um usuário
}

model propertyMedia{ 
  id Int @id @default(autoincrement())
  property_id Int
  type MediaTypes
  url String
  order Int
  public_id String @unique
  uploaded_at DateTime @default(now())

  property properties @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@index([property_id, type]) // Queries por tipo de media
  @@index([uploaded_at]) // Limpeza de arquivos temporários
}

model propertyLocalization {
  id Int @id @default(autoincrement())
  property_id Int @unique
  latitude Decimal?
  longitude Decimal?
  address_info String
  neighborhood String
  municipality String

  property properties @relation(fields: [property_id], references: [id],onDelete: Cascade)

  // ✅ Índices para busca geográfica
  @@index([municipality, neighborhood])
  @@index([latitude, longitude]) // Se usar query de proximidade no futuro
}

model propertyCompartments {
  id Int @id @default(autoincrement())
  property_id Int 
  quantity Int
  type  CompartmentsTypes

  property properties @relation(fields: [property_id], references: [id],onDelete: Cascade)

  // ✅ Índices
  @@index([property_id])
}

model propertyListing {
  id          Int       @id @default(autoincrement())
  property_id Int
  listed_at   DateTime  @default(now())
  delisted_at DateTime?
  status      ListingStatus

  property    properties   @relation(fields: [property_id], references: [id], onDelete: Cascade)
  negotiation negociation[]

  // ✅ Índices críticos para busca
  @@index([property_id])
  @@index([property_id, delisted_at])
  @@index([status, delisted_at, id]) // Compound index para searchListings
  @@index([listed_at]) // Ordenação temporal
  @@index([delisted_at]) // Filtro soft-delete
}

model favorites {
  id Int @id @default(autoincrement())
  owner_id Int
  property_id Int
  created_at DateTime @default(now())

  profile_roles profile_roles @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  properties properties @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@index([owner_id]) 
  @@index([property_id]) 
  @@index([owner_id, property_id]) 
  @@unique([owner_id, property_id]) 
}

model negociation {
  id Int @id @default(autoincrement())
  property_listing_id Int
  client_id Int
  owner_id  Int 
  proposed_price Decimal
  accepted_value Decimal?
  status NegociationStatus @default(PENDING)
  created_at DateTime @default(now())


  property_listing propertyListing @relation(fields: [property_listing_id], references: [id], onDelete: Cascade)
  client profile_roles @relation(name: "NegociationClient", fields: [client_id], references: [id], onDelete: Cascade)
  owner profile_roles @relation(name: "NegociationOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  negociationEvents negociationEvent[]
}

model negociationEvent {
  id Int @id @default(autoincrement())
  negociation_id Int
  profile_role_id Int
  event_type NegociationEventType
  event_description String
  event_date DateTime @default(now())

  negociation negociation @relation(fields: [negociation_id], references: [id], onDelete: Cascade)
  profile_roles profile_roles @relation(fields: [profile_role_id], references: [id], onDelete: Cascade)
}



// ============================================================================
// ENUMS
// ============================================================================

enum AccessLevel {
  NORMAL
  SUPER_ADMIN
}

enum ProfileRoles {
  CLIENT
  OWNER
  ADMIN
}

enum UserRoleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProfileType {
  INDIVIDUAL
  COMPANY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum DocType {
  BI
  NIF
  CONTA_BANCARIA
  PHONE           
  PROFILE_PHOTO
  CONTRATO_VENDA
  CONTRATO_ARRENDAMENTO
}

enum Property_purchase {
  FOR_SALE
  FOR_RENT
}

enum TypeProperties {
  APARTAMENTO
  VIVENDA 
  ESCRITORIO
  FAZENDA
  TERRENO
  LOJA
  ARMAZEM
  HOTEL
  PENTHOUSE
  DUPLEX
  TRIPLEX
  QUARTO
  SUITE
  CONDOMINIO
  RESORT
  HOSPITAL
  ESCOLA
  RESTAURANTE
  CINEMA
  SHOPPING
}

enum PropertyStatus {
  PUBLICADO        
  NAO_PUBLICADO    
  EM_ANALISE       
}

enum ListingStatus {
 RESERVADO
 VENDIDO
 ALUGADO
 DISPONIVEL

}

enum propertySelingStatus {
  DISPONIVEL
  RESERVADO
  VENDIDO
  ALUGADO          
  CANCELADO        
}

enum PropertyMediaStatus {
  FAILED
  UPLOADED
  PENDING
}

enum NegociationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum NegociationEventType {
  PROPOSAL
  ACCEPTANCE
  REJECTION
  CANCELLATION
  OTHER
}

enum MediaTypes {
  IMAGEM
  VIDEO
}

enum CompartmentsTypes {
  QUARTO
  SALA_DE_ESTAR
  SALA_DE_LAZER
  ESCRITORIO
  QUARTO_DE_BANHO
  COZINHA
  LAVANDARIA
  GARAGEM
  VARANDA
  CLOSET
  DESPENSA
  HALL_DE_ENTRADA
  SALA_DE_JANTAR
  BIBLIOTECA
  QUARTO_DE_VISITAS
  SUITE_PRINCIPAL
  ADEGA
  QUARTO_DE_EMPREGADOS
  RECEPCAO
  SALA_DE_REUNIOES
  AUDITORIO
  LOJA
  ARMAZEM
  CANTINA
  GINASIO
  SPA
  PISCINA
  TERRAÇO
}

enum UserBanStatus { 
  ACTIVE   
  SUSPENDED
  BANNED  
} 

enum ListingRestrictionStatus {
  UNBANNED   
  SUSPENDED    
  BANNED  
}