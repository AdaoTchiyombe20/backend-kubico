// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id             Int       @id @unique @default(autoincrement())
  email          String    @unique
  password       String
  status         UserStatus @default(ACTIVE)
  email_verified Boolean   @default(false)
  last_access    DateTime?
  date_register  DateTime  @default(now())

  refreshTokens  refresh_tokens[]
  emailVerified  emailVerification[]
  profile        profiles?
  admin          admins?

  @@index([email])
}

model roles {
  id          Int           @id @default(autoincrement())
  role        ProfileRoles     @unique
  description String
  
  user_role   profile_roles[]
}

model profiles {
  id              Int          @id @default(autoincrement())
  user_id         Int          @unique
  type            ProfileType
  deleted_at      DateTime?

  userMidia       profile_medias[]
  user_role       profile_roles[]

  person_profile  person_profiles?
  company_profile company_profiles?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade )
}

model person_profiles {
  id         Int      @id @default(autoincrement())
  profile_id Int      @unique
  full_name  String
  birth_date DateTime
  phone      String

  profile profiles @relation(fields: [profile_id], references: [id])
}

model company_profiles {
  id               Int      @id @default(autoincrement())
  profile_id       Int      @unique
  legal_name       String
  phone            String

  profile profiles @relation(fields: [profile_id], references: [id])
}

model profile_medias {
  id              Int       @id @default(autoincrement())
  profile_id      Int
  type            DocType
  document_number String
  is_current      Boolean   @default(true)
  is_verified     Boolean   @default(false)
  verified_at     DateTime?
  inserted_in     DateTime  @default(now())
  deleted_at      DateTime?

  profile profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([type, document_number])
  @@index([profile_id, type])
  @@index([profile_id, type, is_current])
}

model profile_roles {
  id          Int            @id @default(autoincrement())
  profile_id  Int
  role_id     Int
  status      UserRoleStatus @default(PENDING)
  is_active   Boolean        @default(false)
  approved_at DateTime?
  created_at  DateTime       @default(now())

  role     roles    @relation(fields: [role_id], references: [id])
  profile  profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  admin    admins?  @relation(name: "AdminProfile")

  @@unique([profile_id, role_id], name: "profile_id_role_id")
  properties properties[] 
  property_history propertyHistory[]
}

model admins {
  id               Int         @id @default(autoincrement())
  profile_role_id  Int         @unique
  user_id          Int         @unique
  adminsName       String
  access_level     AccessLevel @default(NORMAL)
  date_register    DateTime    @default(now())
  deleted_at       DateTime?

  profile_role   profile_roles   @relation(name: "AdminProfile", fields: [profile_role_id], references: [id], onDelete: Cascade)
  user           users           @relation(fields: [user_id], references: [id])
}

model refresh_tokens {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  user_id   Int
  expiresAt DateTime
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([token])
  @@index([expiresAt])
}

model emailVerification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  code       String
  expires_at DateTime
  used       Boolean  @default(false)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([user_id, used, expires_at])
}

model properties {
  id Int @id @default(autoincrement())
  id_owner Int 
  title String
  type_of_property TypeProperties
  description String
  status_property PropertyStatus
  create_at DateTime @default(now())
  price Int
  total_area Int?

  owner profile_roles @relation(fields: [id_owner],references: [id], onDelete: Cascade)
  
  property_history propertyHistory[]
  property_medias propertyMedia[]
  property_localization propertyLocalization[]
  property_compartments propertyCompartments[]
}

model propertyHistory {
  id Int @id @default(autoincrement())
  id_owner Int 
  id_property Int 
  last_status PropertyStatus
  new_status PropertyStatus
  started_at DateTime @default(now())
  ended_at DateTime?

  owner profile_roles @relation(fields: [id_owner], references: [id], onDelete: Cascade)
  property properties @relation(fields: [id_property], references: [id], onDelete: Cascade)
}

model propertyMedia{ 
  id Int @id @default(autoincrement())
  property_id Int
  type MediaTypes
  url String
  order Int
  uploaded_at DateTime @default(now())

  property properties @relation(fields: [property_id], references: [id])
}

model propertyLocalization {
  id Int @id @default(autoincrement())
  property_id Int 
  latitude Int
  longitude Int
  address_info String
  neighborhood String
  municipality String

  property properties @relation(fields: [property_id], references: [id])
}

model propertyCompartments {
  id Int @id @default(autoincrement())
  property_id Int 
  quantity Int
  type  CompartmentsTypes

  property properties @relation(fields: [property_id], references: [id])
}

// ============================================================================
// ENUMS
// ============================================================================

enum AccessLevel {
  NORMAL
  SUPER_ADMIN
}

enum ProfileRoles {
  CLIENT
  OWNER
  ADMIN
}

enum UserRoleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProfileType {
  INDIVIDUAL
  COMPANY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum DocType {
  BI
  NIF
  CONTA_BANCARIA
  PROFILE_PHOTO
  CONTRATO_VENDA
  CONTRATO_ARRENDAMENTO
}

enum TypeProperties {
  APARTAMENTO
  VIVENDA 
  ESCRITORIO
  FAZENDA
  TERRENO
}

enum PropertyStatus {
  DISPONIVEL
  RESERVADO
  ALUGADO
  VENDIDO
  INATIVO
}

enum MediaTypes {
  IMAGEM
  VIDEO
}

enum CompartmentsTypes {
  QUARTO
  SALA_DE_ESTAR
  SALA_DE_LAZER
  ESCRITORIO
  QUARTO_DE_BANHO
  COZINHA
  LAVANDARIA
  GARAGEM
}
